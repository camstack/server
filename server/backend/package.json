{
  "name": "@camstack/server",
  "version": "1.2.810",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/camstack/server.git",
    "directory": "server/backend"
  },
  "homepage": "https://camstack-docs.zentik.app",
  "bugs": {
    "url": "https://github.com/camstack/server/issues"
  },
  "private": false,
  "files": [
    "dist",
    "system/dist",
    "system/assets",
    "system/package.json",
    "scripts/closure-postinstall.mjs",
    ".env.example",
    "THIRD_PARTY_MODELS.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./main.js": "./dist/main.js",
    "./launcher.js": "./dist/launcher.js",
    "./starter.js": "./dist/starter.js",
    "./launch-args.js": "./dist/launch-args.js",
    "./system": {
      "types": "./system/dist/index.d.ts",
      "import": "./system/dist/index.mjs",
      "require": "./system/dist/index.js"
    },
    "./system/addon-utils": {
      "types": "./system/dist/addon-utils.d.ts",
      "import": "./system/dist/addon-utils.mjs",
      "require": "./system/dist/addon-utils.js"
    },
    "./system/package.json": "./system/package.json",
    "./system/dist/*": "./system/dist/*",
    "./system/assets/*": "./system/assets/*"
  },
  "scripts": {
    "build": "node ../../scripts/sync-system-into-server.mjs && ../../scripts/tsc7 -p tsconfig.build.json && tsup && node scripts/copy-closure-patches.mjs",
    "postinstall": "node scripts/closure-postinstall.mjs",
    "dev": "npx concurrently -n server,ui -c blue,magenta \"CAMSTACK_RESTART_TOUCH_FILE=src/launcher.ts tsx watch --env-file=.env --ignore=./camstack-data --ignore=../../packages/core/dist --ignore=../../packages/sdk/dist --ignore=../../packages/ui-library/dist src/launcher.ts\" \"cd ../../packages/addon-admin-ui && npx vite --port 3001\"",
    "serve": "CAMSTACK_RESTART_TOUCH_FILE=src/launcher.ts tsx watch --env-file=.env --ignore=./camstack-data --ignore=../../packages/core/dist --ignore=../../packages/sdk/dist --ignore=../../packages/ui-library/dist src/launcher.ts",
    "serve:once": "tsx --env-file=.env src/launcher.ts",
    "start": "node --env-file=.env dist/launcher.js",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run --reporter verbose",
    "test:watch": "vitest",
    "test:cluster": "vitest run -c vitest.cluster.config.ts --reporter verbose"
  },
  "camstack": {
    "agentBootstrapAddons": [
      "@camstack/addon-pipeline",
      "@camstack/addon-decoder-nodeav",
      "@camstack/addon-agent-ui"
    ],
    "agentOnlyBootstrapAddons": [
      "@camstack/addon-agent-ui"
    ],
    "requires": {
      "addons": {
        "@camstack/addon-admin-ui": ">=1.2.617",
        "@camstack/addon-agent-ui": ">=1.2.345",
        "@camstack/addon-ai": ">=0.4.181",
        "@camstack/addon-cloudflare": ">=1.2.160",
        "@camstack/addon-export-alexa": ">=1.2.190",
        "@camstack/addon-export-google": ">=0.1.132",
        "@camstack/addon-export-hap": ">=1.2.198",
        "@camstack/addon-google-services": ">=0.2.44",
        "@camstack/addon-import-alexa": ">=0.2.199",
        "@camstack/addon-matter-broker": ">=0.2.164",
        "@camstack/addon-provider-amcrest": ">=0.2.170",
        "@camstack/addon-provider-bosch": ">=0.1.43",
        "@camstack/addon-provider-dreame": ">=0.2.172",
        "@camstack/addon-provider-dreo": ">=0.2.162",
        "@camstack/addon-provider-ecowitt": ">=0.2.160",
        "@camstack/addon-provider-enpal": ">=0.1.14",
        "@camstack/addon-provider-esphome": ">=0.1.17",
        "@camstack/addon-provider-gree": ">=0.2.156",
        "@camstack/addon-provider-hikvision": ">=1.2.186",
        "@camstack/addon-provider-homeassistant": ">=1.2.673",
        "@camstack/addon-provider-homematic": ">=1.2.187",
        "@camstack/addon-provider-mqtt-ha": ">=0.1.43",
        "@camstack/addon-provider-onvif": ">=1.2.158",
        "@camstack/addon-provider-petkit": ">=0.2.166",
        "@camstack/addon-provider-rademacher": ">=0.2.164",
        "@camstack/addon-provider-reolink": ">=1.2.234",
        "@camstack/addon-provider-rtsp": ">=1.2.156",
        "@camstack/addon-provider-tuya": ">=0.2.157",
        "@camstack/addon-provider-unifi": ">=0.2.161",
        "@camstack/addon-provider-unraid": ">=0.2.162",
        "@camstack/addon-provider-velux": ">=0.2.164",
        "@camstack/addon-provider-vesync": ">=0.2.154",
        "@camstack/addon-provider-wyze": ">=0.2.171",
        "@camstack/addon-smtp-nodemailer": ">=1.2.154",
        "@camstack/addon-static-turn": ">=1.2.147",
        "@camstack/addon-training": ">=0.1.136"
      },
      "wrapper": {
        "desktop": ">=0.0.1",
        "image": ">=0.0.1"
      }
    }
  },
  "dependencies": {
    "@camstack/addon-admin-ui": "*",
    "@camstack/addon-agent-ui": "*",
    "@camstack/addon-auth": "*",
    "@camstack/addon-benchmark": "*",
    "@camstack/addon-decoder-nodeav": "*",
    "@camstack/addon-notifiers": "*",
    "@camstack/addon-pipeline": "*",
    "@camstack/addon-pipeline-orchestrator": "*",
    "@camstack/addon-post-analysis": "*",
    "@camstack/develop": "*",
    "@camstack/sdk": "*",
    "@camstack/types": "*",
    "@camstack/ui-library": "*",
    "@fastify/compress": "^9.0.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@msgpack/msgpack": "^3.1.3",
    "@trpc/client": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "croner": "^10.0.1",
    "esbuild": "^0.27.7",
    "fastify": "^5",
    "jsonwebtoken": "^9.0.0",
    "moleculer": "0.15.0",
    "node-av": "~6.1.0",
    "node-pty": "^1.0.0",
    "otplib": "13.4.1",
    "sharp": "^0.35.2",
    "sqlite-vec": "^0.1.9",
    "ssh2": "^1.16.0",
    "superjson": "^2.2.6",
    "systeminformation": "^5.0.0",
    "tar": "7.5.16",
    "undici": "^7.28.0",
    "werift": "0.22.9",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@swc/core": "^1.15.18",
    "@types/node": "^24",
    "@types/tar": "^7.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4",
    "typescript": "~6.0.3",
    "unplugin-swc": "^1.5.9",
    "vite": "^8.0.11",
    "vitest": "*",
    "@camstack/node-root": "*",
    "tsup": "^8.0.0"
  },
  "nx": {
    "implicitDependencies": [
      "@camstack/addon-benchmark",
      "@camstack/server-framework"
    ],
    "targets": {
      "build": {
        "parallelism": false
      }
    }
  }
}
