{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    // This checkout's built types. A git worktree's root node_modules is the
    // main checkout, so Node would otherwise typecheck a sibling tree's dist.
    "paths": {
      "@camstack/types": ["../../packages/types/dist/index.d.ts"],
      "@camstack/types/*": ["../../packages/types/dist/*"]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/scripts",
    "src/**/__tests__",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
