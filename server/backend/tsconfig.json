{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "ignoreDeprecations": "6.0",
    "noEmit": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/scripts",
    "src/**/__tests__",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
