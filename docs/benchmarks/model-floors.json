{
  "_about": {
    "method": "floor = lowest confidence at which the model makes no more false positives than the production root (yolov9m-320-int8 at person 0.65 / vehicle 0.50 / animal 0.50) on the same 409 hub frames; median over device runs; rounded to 0.05; minimum 0.25",
    "groundTruth": "pseudo-GT = yolo26x@1280 AND RT-DETR-x@640 ensemble",
    "fpBudget": {
      "person": 5,
      "vehicle": 1,
      "animal": 3,
      "package": 1
    },
    "frames": 409,
    "precisionRecall": "P/R per class at the recommended floor (median over runs); gt = objects of that class in the set",
    "packageNote": "package (suitcase/backpack/handbag) has 7 objects in the set: keep 0.50, not calibrated",
    "caveat": "floors carry roughly +/-0.05-0.10 noise (FP counts are single digits); vehicle uses a 1-FP budget"
  },
