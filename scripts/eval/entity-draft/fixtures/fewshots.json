 {
  "kind": "composition",
  "description": "Temperatura media della camera da letto e del bagno",
  "entity": {
   "target": {
    "kind": "new",
    "type": "sensor"
   },
   "features": [
    {
     "kind": "fields",
     "cap": "temperature-sensor",
     "fields": {
      "temperature": {
       "kind": "expression",
       "expr": "avg(a, b)",
       "bindings": {
        "a": {
         "kind": "from",
         "source": {
          "addonId": "provider-demo",
          "stableId": "demo:015"
         },
         "cap": "temperature-sensor",
         "fieldPath": "temperature"
        },
        "b": {
         "kind": "from",
         "source": {
          "addonId": "provider-demo",
          "stableId": "demo:019"
         },
         "cap": "temperature-sensor",
         "fieldPath": "temperature"
        }
       }
      },
      "lastFetchedAt": {
       "kind": "expression",
       "expr": "max(a, b)",
       "bindings": {
        "a": {
         "kind": "from",
         "source": {
          "addonId": "provider-demo",
          "stableId": "demo:015"
         },
         "cap": "temperature-sensor",
         "fieldPath": "lastFetchedAt"
        },
        "b": {
         "kind": "from",
         "source": {
          "addonId": "provider-demo",
          "stableId": "demo:019"
         },
         "cap": "temperature-sensor",
         "fieldPath": "lastFetchedAt"
        }
       }
      }
     }
    }
   ]
  }
 },
 {
  "kind": "composition",
  "description": "A sensor that is on when the living room or the kitchen has motion or smoke",
  "entity": {
   "target": {
    "kind": "new",
    "type": "sensor"
   },
   "features": [
    {
     "kind": "fields",
     "cap": "binary",
     "fields": {
      "on": {
       "kind": "expression",
       "expr": "any(a, b)",
       "bindings": {
        "a": {
         "kind": "from",
         "source": {
          "addonId": "provider-demo",
          "stableId": "demo:005"
         },
         "cap": "motion",
         "fieldPath": "detected"
        },
        "b": {
         "kind": "from",
         "source": {
          "addonId": "provider-demo",
          "stableId": "demo:008"
         },
         "cap": "smoke",
         "fieldPath": "detected"
        }
       }
      },
      "lastChangedAt": {
       "kind": "expression",
       "expr": "now",
       "bindings": {}
      }
     }
    }
   ]
  }
 },
