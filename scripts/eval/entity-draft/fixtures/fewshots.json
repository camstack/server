[
 {
  "kind": "automation",
  "description": "Quando il sensore di movimento in salone rileva movimento, accendi la lampada del divano",
  "entity": {
   "when": {
    "kind": "device-becomes",
    "deviceId": 5,
    "cap": "motion",
    "fieldPath": "detected",
    "becomes": true
   },
   "actions": [
    {
     "kind": "cap",
     "actionId": "switch.on",
     "target": {
      "kind": "devices",
      "ids": [
       2
      ]
     }
    }
   ]
  }
 },
 {
  "kind": "automation",
  "description": "At 7:00 on weekdays open the bedroom blind",
  "entity": {
   "when": {
    "kind": "schedule",
    "at": {
     "kind": "clock",
     "hh": 7,
     "mm": 0
    },
    "days": [
     "mon",
     "tue",
     "wed",
     "thu",
     "fri"
    ]
   },
   "actions": [
    {
     "kind": "cap",
     "actionId": "cover.open",
     "target": {
      "kind": "devices",
      "ids": [
       11
      ]
     }
    }
   ]
  }
 },
 {
  "kind": "automation",
  "description": "When a person is seen by the garage camera in the Vialetto zone, turn on the veranda light",
  "entity": {
   "when": {
    "kind": "detection",
    "subjects": [
     {
      "macro": "person"
     }
    ],
    "deviceIds": [
     22
    ],
    "zones": [
     "Vialetto"
    ]
   },
   "actions": [
    {
     "kind": "cap",
     "actionId": "switch.on",
     "target": {
      "kind": "devices",
      "ids": [
       17
      ]
     }
    },
    {
     "kind": "wait",
     "seconds": 120
    },
    {
     "kind": "cap",
     "actionId": "switch.off",
     "target": {
      "kind": "devices",
      "ids": [
       17
      ]
     }
    }
   ]
  }
 },
 {
