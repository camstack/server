[
 {
  "id": "comp-01",
  "lang": "en",
  "description": "Average temperature of the living room, veranda and bathroom sensors, as one sensor",
  "entity": {
   "target": {
    "kind": "new",
    "type": "sensor"
   },
   "features": [
    {
     "kind": "fields",
     "cap": "temperature-sensor",
     "fields": {
      "temperature": {
       "kind": "expression",
       "expr": "round(avg(a, b, c), 1)",
       "bindings": {
        "a": {
         "kind": "from",
         "source": {
          "addonId": "provider-demo",
          "stableId": "demo:006"
         },
         "cap": "temperature-sensor",
         "fieldPath": "temperature"
        },
        "b": {
         "kind": "from",
         "source": {
          "addonId": "provider-demo",
          "stableId": "demo:019"
         },
         "cap": "temperature-sensor",
         "fieldPath": "temperature"
        },
        "c": {
         "kind": "from",
         "source": {
          "addonId": "provider-demo",
          "stableId": "demo:015"
         },
         "cap": "temperature-sensor",
         "fieldPath": "temperature"
        }
       }
      },
      "lastFetchedAt": {
       "kind": "expression",
       "expr": "max(a, b, c)",
       "bindings": {
        "a": {
         "kind": "from",
         "source": {
          "addonId": "provider-demo",
          "stableId": "demo:006"
         },
         "cap": "temperature-sensor",
         "fieldPath": "lastFetchedAt"
        },
        "b": {
         "kind": "from",
         "source": {
          "addonId": "provider-demo",
          "stableId": "demo:019"
         },
         "cap": "temperature-sensor",
         "fieldPath": "lastFetchedAt"
        },
        "c": {
         "kind": "from",
         "source": {
          "addonId": "provider-demo",
          "stableId": "demo:015"
         },
         "cap": "temperature-sensor",
         "fieldPath": "lastFetchedAt"
        }
       }
      }
     }
    }
   ]
  },
  "mustHave": [
   "avg"
  ]
 },
