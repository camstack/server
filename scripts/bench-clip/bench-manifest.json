{
  "id": "camstack-bench-v1",
  "fps": 15,
  "width": 1920,
  "height": 1080,
  "note": "Expected content per segment, from the sources (not yet verified with a reference model run). guardSec around each cut is excluded from any scoring.",
  "guardSec": 0.5,
  "segments": [
    {
      "id": "S1",
      "fromSec": 0,
      "toSec": 14,
      "lighting": "day",
      "expect": {
        "objects": ["person"],
        "faces": true,
        "steps": ["object-detection", "face-detection", "face-recognition", "clip-embedding"]
      }
    },
    {
      "id": "S2",
      "fromSec": 14,
      "toSec": 26,
      "lighting": "day",
      "expect": { "objects": ["car", "truck", "bus", "person"], "steps": ["object-detection"] }
    },
    {
      "id": "S3",
      "fromSec": 26,
      "toSec": 34,
      "lighting": "day",
      "expect": { "objects": ["car", "person"], "steps": ["object-detection"] }
    },
    {
      "id": "S4",
      "fromSec": 34,
      "toSec": 46,
      "lighting": "day",
      "expect": {
        "objects": ["car"],
        "plates": [{ "text": "CS123AB", "maxEditDistance": 1 }],
        "steps": ["object-detection", "plate-detection", "plate-recognition"]
      }
    },
    {
      "id": "S5",
      "fromSec": 46,
      "toSec": 66,
      "lighting": "day",
      "expect": {
        "objects": ["person"],
        "package": true,
        "faces": false,
        "steps": ["object-detection"]
      }
    },
    {
      "id": "S6",
      "fromSec": 66,
      "toSec": 76,
      "lighting": "day",
      "expect": {
        "objects": ["person", "bicycle"],
        "faces": true,
        "steps": ["object-detection", "face-detection"]
      }
    },
    {
      "id": "S7",
      "fromSec": 76,
      "toSec": 86,
      "lighting": "day",
      "expect": { "objects": ["cat"], "steps": ["object-detection", "animal-classifier"] }
    },
    {
      "id": "S8",
      "fromSec": 86,
      "toSec": 96,
      "lighting": "day",
      "expect": { "objects": ["bird"], "steps": ["object-detection", "animal-classifier"] }
    },
    {
      "id": "S9",
      "fromSec": 96,
      "toSec": 106,
      "lighting": "ir",
      "expect": { "objects": ["person", "car", "bus"], "steps": ["object-detection"] }
    },
    {
      "id": "S10",
      "fromSec": 106,
      "toSec": 114,
      "lighting": "night",
      "expect": { "objects": [], "steps": [] }
    }
  ]
}
