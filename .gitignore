# tsc artifacts that occasionally leak into source dirs when a build
# script is run with the wrong cwd (`tsc --emitDeclarationOnly` without
# `-p tsconfig.json` walks the whole monorepo). Belt-and-braces guard.
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
packages/*/src/**/*.js.map
server/*/src/**/*.d.ts
server/*/src/**/*.d.ts.map
server/*/src/**/*.js.map
# Exceptions — hand-written ambient/shim type declarations that LIVE in
# source dirs (not generated by tsc). Add new ones here as needed.
!packages/addon-post-analysis/src/embedding-encoder/shared/onnxruntime.d.ts
!packages/addon-provider-onvif/src/onvif.d.ts
!packages/ui-library/src/lucide-icons-module.d.ts
!packages/werift-turn-fix/src/node-turn.d.ts
!packages/addon-pipeline/src/recorder/scrub/mp4box.d.ts

# restreamer binary (downloaded by scripts/install-go2rtc.sh)
bin/

# electron-agent build-time python shim (created by `_python-shim` script)
packages/electron-agent/.python-shim/
packages/electron-agent/release/

# electron hub build-time artifacts
packages/electron/.python-shim/
packages/electron/release/
packages/electron/.hub-deps/

# ML model files (downloaded at runtime)
*.pt
*.onnx
*.traineddata

# Working notes (superpowers specs, archive handovers, agent ledgers) moved to
# the sibling planning repo. A local recreation of .superpowers/ must not commit
# review diffs or brainstorm server state.
.superpowers/**/*.diff
.superpowers/brainstorm/*/state/
.superpowers/brainstorm/*/.*

# Test output (annotated images)
test-output/

# Local model cache
hf-models/

# npm auth
.npmrc

# Claude Code runtime artifacts — local state only.
#
# `.claude/*` rather than `.claude/`: git cannot re-include anything inside an
# excluded DIRECTORY, so excluding the directory itself would make the negation
# below impossible.
#
# `skills/` are project assets, not runtime artifacts — they encode the procedures
# for extending this repo and are useless if they live on one machine. They were
# ignored by accident, which is how three of them got written and never committed;
# the docs drift guard caught it from a fresh CI checkout.
.claude/*
!.claude/skills/
# Agent definitions stay local EXCEPT the ones reviewed like skills. Re-include
# the directory, ignore its contents, then re-include each tracked agent by
# name — a new tracked agent is a deliberate line here, not an accident.
!.claude/agents/
.claude/agents/*
!.claude/agents/camstack-ui-engineer.md
!.claude/agents/camstack-implementer.md
!.claude/agents/camstack-test-fixer.md
!.claude/agents/camstack-docs-writer.md
!.claude/agents/camstack-diagnostician.md

__pycache__/
yolo11n-seg_saved_model/
calibration_image_sample_data*
*.pt

# Build-leak detection — compiled `.js` / `.d.ts` files must NEVER live in
# `src/`; they belong in `dist/`. We keep these paths visible in `git status`
# (no ignore rules) so an accidental workspace-wide `tsc -b` instantly
# surfaces 200+ untracked files as a loud warning, instead of silently
# poisoning the esbuild loader with stale JSX-in-`.js` files. Two
# hand-written ambient declarations are the only legitimate `.d.ts` under
# `src/` — everything else is garbage.
server/backend/log.txt
# Added by code-review-graph
.code-review-graph/
bench-results/

# Module Federation Vite plugin scratch dir (per-build diagnostics).
.mf/
packages/addon-tailscale/*.tgz
packages/*/*.tgz

# Agent runtime data dir from empirical agent testing
camstack-data-agent/
.DS_Store
server/backend/log.prev.txt

# Local ML export artifacts (models are fetched on-demand at runtime, never committed)
exported-models/
dev-overlay/

# Leftover static-site output. Nothing in this repo writes it.
site/

# Local dumps, one-shot probes, minted tokens. Always ignored — do not add
# exceptions. The reusable hub tRPC caller lives in scripts/hub/hub.mjs;
# secrets stay here as scratchpad/.tok and scratchpad/.pw.
scratchpad/

# tsx / node compile cache (local)
.tmp-tsx/
.pytest_cache/
.worktrees/

# Local editor and agent state (not part of the public tree).
.cursor/
