{
  "name": "@dominevo/addon-provider-vesync",
  "version": "0.1.0",
  "description": "VeSync cloud-account device-provider addon for Dominevo — Levoit / Cosori air purifiers as Fan devices (power, speed, preset, child-lock, display, air-quality + filter-life sensors)",
  "keywords": [
    "camstack",
    "addon",
    "camstack-addon",
    "vesync",
    "levoit",
    "cosori",
    "air-purifier",
    "fan",
    "provider"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dominevo/server.git",
    "directory": "packages/addon-provider-vesync"
  },
  "homepage": "https://camstack-docs.zentik.app",
  "bugs": {
    "url": "https://github.com/dominevo/server/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "camstack": {
    "displayName": "VeSync Provider",
    "addons": [
      {
        "id": "provider-vesync",
        "category": "providers",
        "name": "VeSync",
        "version": "0.1.0",
        "description": "Sign in to a VeSync cloud account and adopt its air purifiers as Fan devices (speed, preset, child-lock, display + air-quality / filter-life sensors) and its humidifiers as Humidifier devices (target humidity, mode, display + humidity / water-tank sensors)",
        "entry": "./dist/addon.js",
        "icon": "assets/icon.png",
        "color": "#4a8cff",
        "integrationRole": "devices",
        "instanceMode": "multiple",
        "mode": "account",
        "execution": {
          "placement": "hub-only"
        },
        "capabilities": [
          {
            "name": "device-provider"
          },
          {
            "name": "integration-instances"
          },
          {
            "name": "device-adoption"
          }
        ]
      }
    ],
    "requires": {
      "server": ">=0.1.0"
    }
  },
  "files": [
    "dist",
    "i18n",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "publish:npm": "npm publish --access public"
  },
  "devDependencies": {
    "@dominevo/types": "0.1.0",
    "tsvesync": "^1.7.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.11",
    "vitest": "^2.0.0",
    "zod": "^4.3.6"
  }
}
