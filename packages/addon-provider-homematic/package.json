{
  "name": "@camstack/addon-provider-homematic",
  "version": "1.2.171",
  "description": "Homematic / HomematicIP (CCU3 / RaspberryMatic) device-provider addon for CamStack — wraps the nodehomematic library",
  "keywords": [
    "camstack",
    "addon",
    "camstack-addon",
    "homematic",
    "homematicip",
    "ccu",
    "raspberrymatic",
    "provider"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/camstack/server.git",
    "directory": "packages/addon-provider-homematic"
  },
  "homepage": "https://camstack-docs.zentik.app",
  "bugs": {
    "url": "https://github.com/camstack/server/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "camstack": {
    "displayName": "Homematic Provider",
    "addons": [
      {
        "id": "provider-homematic",
        "category": "providers",
        "name": "Homematic",
        "version": "0.1.0",
        "description": "Adopt a Homematic CCU3 / RaspberryMatic (as a Gateway device) and its switches, covers, lights, locks, thermostats and sensors, from an integration over the local network",
        "entry": "./dist/addon.js",
        "icon": "assets/icon.svg",
        "color": "#e2001a",
        "instanceMode": "multiple",
        "mode": "account",
        "execution": {
          "placement": "hub-only"
        },
        "capabilities": [
          {
            "name": "device-provider"
          },
          {
            "name": "device-adoption"
          },
          {
            "name": "connection-test"
          },
          {
            "name": "addon-pages-source"
          }
        ],
        "pages": [
          {
            "id": "homematic-ccu",
            "label": "Homematic CCU",
            "icon": "plug",
            "path": "/addon/homematic-ccu",
            "remoteName": "addon_provider_homematic_page",
            "bundle": "remoteEntry.js",
            "section": "administration"
          }
        ]
      }
    ]
  },
  "files": [
    "dist",
    "i18n",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build && vite build -c vite.page.config.ts",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "publish:npm": "npm publish --access public",
    "build:server": "vite build",
    "build:page": "vite build -c vite.page.config.ts",
    "dev:page": "vite -c vite.page.config.ts"
  },
  "dependencies": {
    "nodehomematic": "^0.5.1"
  },
  "peerDependencies": {
    "@camstack/types": "*",
    "zod": "^4.3.6",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@camstack/types": "*",
    "@camstack/ui-library": "*",
    "@module-federation/vite": "^1.16.9",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@trpc/client": "^11.16.0",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "superjson": "^2.0.0",
    "tailwindcss": "^4.2.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.11",
    "vitest": "^3.2.4",
    "zod": "^4.3.6"
  }
}
