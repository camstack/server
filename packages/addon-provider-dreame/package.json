{
  "name": "@camstack/addon-provider-dreame",
  "version": "0.2.156",
  "description": "Dreame robot-vacuum / lawn-mower device-provider addon for CamStack — wraps the @apocaliss92/nodedreame Dreamehome cloud client",
  "keywords": [
    "camstack",
    "addon",
    "camstack-addon",
    "dreame",
    "vacuum",
    "mower",
    "dreamehome",
    "provider"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/camstack/server.git",
    "directory": "packages/addon-provider-dreame"
  },
  "homepage": "https://camstack-docs.zentik.app",
  "bugs": {
    "url": "https://github.com/camstack/server/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "camstack": {
    "displayName": "Dreame Provider",
    "addons": [
      {
        "id": "provider-dreame",
        "category": "providers",
        "name": "Dreame",
        "version": "0.1.0",
        "description": "Adopt Dreame robot vacuums and lawn mowers via the Dreamehome cloud",
        "entry": "./dist/addon.js",
        "icon": "assets/icon.svg",
        "color": "#0a7cff",
        "mode": "account",
        "instanceMode": "multiple",
        "execution": {
          "placement": "hub-only"
        },
        "capabilities": [
          {
            "name": "device-provider"
          },
          {
            "name": "device-adoption"
          },
          {
            "name": "consumables"
          },
          {
            "name": "navigation"
          },
          {
            "name": "recording-signal"
          },
          {
            "name": "connection-test"
          },
          {
            "name": "running-state"
          }
        ]
      }
    ]
  },
  "files": [
    "dist",
    "i18n",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "publish:npm": "npm publish --access public"
  },
  "devDependencies": {
    "@apocaliss92/nodedreame": "^1.12.5",
    "@apocaliss92/nodelink-js": "^0.6.7",
    "@camstack/types": "*",
    "typescript": "~6.0.3",
    "vite": "^8.0.11",
    "vitest": "^2.0.0",
    "zod": "^4.3.6"
  }
}
