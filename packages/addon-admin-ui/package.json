{
  "name": "@camstack/addon-admin-ui",
  "version": "1.2.494",
  "private": false,
  "type": "module",
  "description": "Admin UI — Vite frontend build and server-side addon",
  "repository": {
    "type": "git",
    "url": "https://github.com/camstack/server.git",
    "directory": "packages/addon-admin-ui"
  },
  "homepage": "https://camstack-docs.zentik.app",
  "bugs": {
    "url": "https://github.com/camstack/server/issues"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./server/addon": {
      "types": "./dist/server/addon.d.ts",
      "import": "./dist/server/addon.js",
      "require": "./dist/server/addon.cjs"
    },
    "./package.json": "./package.json"
  },
  "camstack": {
    "displayName": "Admin UI",
    "addons": [
      {
        "id": "admin-ui",
        "category": "system",
        "name": "Admin UI",
        "icon": "assets/icon.svg",
        "version": "0.1.0",
        "description": "Web-based administration interface for CamStack",
        "entry": "./dist/server/addon.js",
        "capabilities": [
          {
            "name": "admin-ui"
          }
        ],
        "protected": true
      }
    ]
  },
  "scripts": {
    "dev": "vite --port 3001",
    "build": "vite build && vite build -c vite.lib.config.ts",
    "build:addon": "tsup",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.server.json",
    "publish:npm": "npm publish --access public"
  },
  "dependencies": {},
  "peerDependencies": {
    "@camstack/types": "*"
  },
  "devDependencies": {
    "@camstack/sdk": "*",
    "@camstack/types": "*",
    "@camstack/ui-library": "*",
    "@module-federation/runtime": "^2.4.0",
    "@module-federation/vite": "^1.16.9",
    "@monaco-editor/react": "^4.7.0",
    "@simplewebauthn/browser": "11.0.0",
    "@tailwindcss/vite": "^4.2.0",
    "@tanstack/react-query": "^5.90.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@trpc/client": "^11.16.0",
    "@trpc/react-query": "^11.16.0",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.10.2",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.16",
    "i18next": "^26.3.1",
    "jsdom": "^29.0.1",
    "konva": "^10.2.3",
    "lucide-react": "^0.576.0",
    "monaco-editor": "^0.56.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.8",
    "react-konva": "^19.2.3",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.2.0",
    "tsup": "^8.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.11",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.0.0",
    "zod": "^4.3.6"
  },
  "nx": {
    "targets": {
      "build": {
        "parallelism": false
      }
    }
  }
}
