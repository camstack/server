{
  "name": "@dominevo/addon-provider-kia",
  "version": "0.1.0",
  "description": "Kia Connect (Kia UVO / Hyundai Bluelink) vehicle device-provider addon for Dominevo: reads the car (odometer, range, fuel, locks, doors, tyre warnings, position) and locks, unlocks and pre-conditions it through the maker cloud, in a bundled Python worker",
  "keywords": [
    "camstack",
    "addon",
    "camstack-addon",
    "kia",
    "vehicle",
    "car",
    "connected-car",
    "cloud",
    "provider"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dominevo/server.git",
    "directory": "packages/addon-provider-kia"
  },
  "homepage": "https://camstack-docs.zentik.app",
  "bugs": {
    "url": "https://github.com/dominevo/server/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "camstack": {
    "displayName": "Kia Connect Provider",
    "addons": [
      {
        "id": "provider-kia",
        "integrationRole": "devices",
        "category": "providers",
        "name": "Kia Connect",
        "version": "0.1.0",
        "description": "Adopt a Kia (or Hyundai / Genesis) connected car: state, position, service distance, lock and climate through the maker cloud",
        "entry": "./dist/addon.js",
        "icon": "assets/icon.svg",
        "color": "#05141f",
        "mode": "account",
        "instanceMode": "multiple",
        "execution": {
          "placement": "hub-only"
        },
        "python": {
          "requirements": "./python/requirements.txt"
        },
        "capabilities": [
          {
            "name": "device-provider"
          },
          {
            "name": "integration-instances"
          },
          {
            "name": "device-adoption"
          }
        ]
      }
    ],
    "requires": {
      "server": ">=0.1.0"
    }
  },
  "files": [
    "dist",
    "python",
    "i18n",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "publish:npm": "npm publish --access public"
  },
  "devDependencies": {
    "@dominevo/types": "0.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.11",
    "vitest": "^2.0.0",
    "zod": "^4.3.6"
  }
}
