{
  "name": "@camstack/sdk",
  "version": "1.2.154",
  "repository": {
    "type": "git",
    "url": "https://github.com/camstack/server.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://camstack-docs.zentik.app",
  "bugs": {
    "url": "https://github.com/camstack/server/issues"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "camstack": {
    "system": false,
    "displayName": "SDK",
    "description": "Backend client + tRPC helpers used by CLI and admin UI."
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build && npx tsx ../../scripts/emit-isolated-dts.ts --root . --src src --out dist",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "publish:npm": "npm publish --access public"
  },
  "dependencies": {
    "superjson": "^2.2.6"
  },
  "peerDependencies": {
    "@camstack/types": ">=1.2.306"
  },
  "devDependencies": {
    "@camstack/types": "*",
    "@trpc/client": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "@types/node": "^24",
    "typescript": "~6.0.3",
    "vite": "^8.0.11",
    "vitest": "^3.2.4",
    "zod": "^4.3.6"
  },
  "nx": {
    "implicitDependencies": [
      "@camstack/types"
    ]
  }
}
