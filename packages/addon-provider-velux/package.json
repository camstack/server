{
  "name": "@camstack/addon-provider-velux",
  "version": "0.2.150",
  "description": "Velux KLF-200 integration for CamStack — the gateway, local-gateway windows (with rain sensor) and shutter covers (positional, no tilt)",
  "keywords": [
    "camstack",
    "addon",
    "camstack-addon",
    "velux",
    "klf-200",
    "klf200",
    "cover",
    "provider"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/camstack/server.git",
    "directory": "packages/addon-provider-velux"
  },
  "homepage": "https://camstack-docs.zentik.app",
  "bugs": {
    "url": "https://github.com/camstack/server/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "camstack": {
    "displayName": "Velux Provider",
    "addons": [
      {
        "id": "provider-velux",
        "category": "providers",
        "name": "Velux",
        "version": "0.1.0",
        "description": "Adopt a Velux KLF-200 gateway, its windows with rain sensor and its roller shutters, from an integration over the local network",
        "entry": "./dist/addon.js",
        "icon": "assets/icon.svg",
        "color": "#00457c",
        "instanceMode": "multiple",
        "mode": "account",
        "execution": {
          "placement": "hub-only"
        },
        "capabilities": [
          {
            "name": "device-provider"
          },
          {
            "name": "device-adoption"
          },
          {
            "name": "connection-test"
          }
        ]
      }
    ]
  },
  "files": [
    "dist",
    "i18n",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "publish:npm": "npm publish --access public"
  },
  "devDependencies": {
    "@camstack/types": "*",
    "klf-200-api": "^8.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.11",
    "vitest": "^2.0.0",
    "zod": "^4.3.6"
  }
}
