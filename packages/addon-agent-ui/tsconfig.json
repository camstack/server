{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "declaration": false,
    "paths": {
      "@camstack/ui-library": [
        "../ui-library/src/index.ts"
      ]
    },
    "noEmit": true
  },
