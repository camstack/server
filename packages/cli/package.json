{
  "name": "dominevo",
  "version": "0.1.0",
  "description": "CLI tool for managing and running Dominevo server",
  "keywords": [
    "camstack",
    "cli",
    "camera",
    "nvr",
    "detection"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dominevo/server.git",
    "directory": "packages/cli"
  },
  "homepage": "https://camstack-docs.zentik.app",
  "bugs": {
    "url": "https://github.com/dominevo/server/issues"
  },
  "type": "module",
  "bin": {
    "dominevo": "dist/cli.js"
  },
  "preferGlobal": true,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "publish:npm": "npm publish"
  },
  "optionalDependencies": {
    "@dominevo/server": "0.1.0"
  },
  "devDependencies": {
    "@dominevo/server": "0.1.0",
    "@dominevo/types": "0.1.0",
    "@types/node": "^24",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@dominevo/develop": "0.1.0",
    "@dominevo/mcp-develop": "0.1.0",
    "@clack/prompts": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.3.6"
  }
}
