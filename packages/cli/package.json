{
  "name": "camstack",
  "version": "1.2.211",
  "description": "CLI tool for managing and running CamStack server",
  "keywords": [
    "camstack",
    "cli",
    "camera",
    "nvr",
    "detection"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/camstack/server.git",
    "directory": "packages/cli"
  },
  "homepage": "https://camstack-docs.zentik.app",
  "bugs": {
    "url": "https://github.com/camstack/server/issues"
  },
  "type": "module",
  "bin": {
    "camstack": "dist/cli.js"
  },
  "preferGlobal": true,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "publish:npm": "npm publish"
  },
  "optionalDependencies": {
    "@camstack/server": "*"
  },
  "devDependencies": {
    "@camstack/server": "*",
    "@camstack/types": "*",
    "@types/node": "^24",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@camstack/develop": "*",
    "@camstack/mcp-develop": "*",
    "@clack/prompts": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.3.6"
  }
}
