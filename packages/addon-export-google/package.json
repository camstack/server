{
  "name": "@dominevo/addon-export-google",
  "version": "0.1.0",
  "description": "Google Home Export — hub-side smart-home fulfillment (SYNC / QUERY / EXECUTE / DISCONNECT) for the non-camera fleet, served over the hub's own OAuth account link. No Google credential is stored, sent or required.",
  "keywords": [
    "camstack",
    "addon",
    "camstack-addon",
    "google",
    "google-home",
    "smart-home"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dominevo/server.git",
    "directory": "packages/addon-export-google"
  },
  "homepage": "https://camstack-docs.zentik.app",
  "bugs": {
    "url": "https://github.com/dominevo/server/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "camstack": {
    "displayName": "Google Home Export",
    "addons": [
      {
        "id": "export-google",
        "category": "exports",
        "name": "Google Home Export",
        "description": "Publishes switches, dimmable lights, locks and covers to Google Home / Google Assistant. The hub answers Google's smart-home fulfillment directly (SYNC / QUERY / EXECUTE / DISCONNECT) and account-links through the hub's own OAuth server — no cloud function and no Google credential. Cameras and proactive Report State are deliberately out of scope.",
        "entry": "./dist/index.js",
        "execution": {
          "placement": "hub-only",
          "group": "integrations"
        },
        "capabilities": [
          {
            "name": "device-export"
          },
          {
            "name": "addon-routes"
          },
          {
            "name": "oauth-integration"
          },
          {
            "name": "integration-instances"
          }
        ],
        "icon": "assets/icon.svg",
        "color": "#4285F4"
      }
    ],
    "requires": {
      "server": ">=0.1.0"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "build:lib": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@dominevo/types": "0.1.0"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@dominevo/types": "0.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.0.0"
  }
}
