{
  "name": "@camstack/addon-provider-unifi",
  "version": "0.2.160",
  "description": "UniFi Network controller device-provider addon for CamStack — local-controller infra switches/APs (as containers) + network-client presence. No cameras.",
  "keywords": [
    "camstack",
    "addon",
    "camstack-addon",
    "unifi",
    "ubiquiti",
    "network",
    "presence",
    "provider"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/camstack/server.git",
    "directory": "packages/addon-provider-unifi"
  },
  "homepage": "https://camstack-docs.zentik.app",
  "bugs": {
    "url": "https://github.com/camstack/server/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "camstack": {
    "displayName": "UniFi Network Provider",
    "addons": [
      {
        "id": "provider-unifi",
        "integrationRole": "devices",
        "category": "providers",
        "name": "UniFi Network",
        "version": "0.1.0",
        "description": "Add a UniFi Network controller as an integration (the connection and credentials are its settings); it adopts the controller as a Gateway, infra devices (switches / APs / gateways) as containers exposing per-port PoE, restart, LED and CPU/temp/clients sensors, plus network clients as presence. Cameras are not in scope.",
        "entry": "./dist/addon.js",
        "icon": "assets/icon.svg",
        "color": "#0559c9",
        "instanceMode": "multiple",
        "mode": "account",
        "execution": {
          "placement": "hub-only"
        },
        "capabilities": [
          {
            "name": "device-provider"
          },
          {
            "name": "integration-instances"
          },
          {
            "name": "device-adoption"
          }
        ]
      }
    ],
    "requires": {
      "server": ">=1.2.788"
    }
  },
  "files": [
    "dist",
    "i18n",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "publish:npm": "npm publish --access public"
  },
  "devDependencies": {
    "@camstack/types": "*",
    "node-unifi": "^2.5.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.11",
    "vitest": "^2.0.0",
    "zod": "^4.3.6"
  }
}
