{
  "name": "@camstack/addon-provider-ecowitt",
  "version": "0.2.145",
  "description": "Ecowitt weather-station device-provider addon for CamStack — wraps the @apocaliss92/nodewitt local-poll / push client",
  "keywords": [
    "camstack",
    "addon",
    "camstack-addon",
    "ecowitt",
    "weather-station",
    "gw1000",
    "gw2000",
    "provider"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/camstack/server"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "camstack": {
    "displayName": "Ecowitt Provider",
    "addons": [
      {
        "id": "provider-ecowitt",
        "category": "providers",
        "name": "Ecowitt",
        "version": "0.1.0",
        "description": "Adopt Ecowitt weather-station gateways and their sensors over the local network (poll or push)",
        "entry": "./dist/addon.js",
        "icon": "assets/icon.svg",
        "color": "#2e8b57",
        "instanceMode": "multiple",
        "mode": "standalone",
        "execution": {
          "placement": "hub-only"
        },
        "capabilities": [
          {
            "name": "device-provider"
          }
        ]
      }
    ]
  },
  "files": [
    "dist",
    "i18n",
    "assets"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "publish:npm": "npm publish --access public"
  },
  "devDependencies": {
    "@apocaliss92/nodewitt": "^1.4.2",
    "@camstack/types": "*",
    "typescript": "~6.0.3",
    "vite": "^8.0.11",
    "vitest": "^2.0.0",
    "zod": "^4.3.6"
  }
}
