{
  "name": "@camstack/addon-smtp-nodemailer",
  "version": "1.2.152",
  "description": "SMTP email provider addon for CamStack — wraps `nodemailer` and registers a `smtp-provider` cap collection entry. Used by notifier addons.",
  "keywords": [
    "camstack",
    "addon",
    "camstack-addon",
    "smtp",
    "email",
    "nodemailer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/camstack/server.git",
    "directory": "packages/addon-smtp-nodemailer"
  },
  "homepage": "https://camstack-docs.zentik.app",
  "bugs": {
    "url": "https://github.com/camstack/server/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "camstack": {
    "displayName": "Email (SMTP)",
    "addons": [
      {
        "id": "smtp-nodemailer",
        "category": "messaging",
        "name": "Email (SMTP)",
        "description": "Outbound SMTP relay backed by `nodemailer`, plus the `smtp-inbound` broker kind: a mailbox cameras can send alarm mail to. Every relay is an integration instance; `smtp-provider.sendEmail` + `verify` serve consumers (notifications, alerts), optionally pinned to one relay.",
        "entry": "./dist/smtp.addon.js",
        "execution": {
          "placement": "hub-only"
        },
        "capabilities": [
          {
            "name": "smtp-provider"
          },
          {
            "name": "integration-instances"
          },
          {
            "name": "broker"
          }
        ]
      }
    ],
    "runtimeDependencies": [
      "mailparser",
      "smtp-server"
    ],
    "requires": {
      "server": ">=1.2.795"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@camstack/types": "*"
  },
  "dependencies": {
    "mailparser": "^3.7.1",
    "nodemailer": "^9.0.1",
    "smtp-server": "^3.13.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@camstack/types": "*",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/smtp-server": "^3.5.13",
    "typescript": "~6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.0.0"
  }
}
