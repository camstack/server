{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": false,
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "noEmit": true,
    // This checkout's built types, not the main checkout a worktree's
    // node_modules points at (the same reason admin-ui paths @camstack/types).
    "paths": {
      "@camstack/types": ["../types/dist/index.d.ts"],
      "@camstack/types/*": ["../types/dist/*"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts",
    "**/__tests__/**"
  ]
}
