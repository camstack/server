{
  "name": "@camstack/addon-static-turn",
  "version": "1.2.146",
  "description": "Static / self-hosted (coturn) TURN provider for CamStack",
  "keywords": [
    "camstack",
    "addon",
    "camstack-addon",
    "turn",
    "coturn",
    "webrtc",
    "relay"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/camstack/server.git",
    "directory": "packages/addon-static-turn"
  },
  "homepage": "https://camstack-docs.zentik.app",
  "bugs": {
    "url": "https://github.com/camstack/server/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "camstack": {
    "displayName": "Static / coturn TURN",
    "addons": [
      {
        "id": "static-turn",
        "category": "networking",
        "name": "TURN Server",
        "version": "1.0.0",
        "entry": "./dist/static-turn.addon.js",
        "execution": {
          "placement": "hub-only",
          "group": "net-access"
        },
        "capabilities": [
          {
            "name": "turn-provider"
          },
          {
            "name": "integration-instances"
          }
        ],
        "icon": "assets/icon.svg",
        "color": "#3B82F6"
      }
    ],
    "requires": {
      "server": ">=1.2.805"
    }
  },
  "files": [
    "dist",
    "i18n",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "publish:npm": "npm publish --access public"
  },
  "peerDependencies": {
    "@camstack/types": "*"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@camstack/types": "*",
    "typescript": "~6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.0.0"
  }
}
