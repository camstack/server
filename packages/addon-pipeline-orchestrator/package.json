{
  "name": "@camstack/addon-pipeline-orchestrator",
  "version": "1.2.645",
  "description": "Hub-side camera-to-agent load balancer — tracks runner capacity and dispatches attachCamera calls to the optimal pipeline-runner instance",
  "keywords": [
    "camstack",
    "addon",
    "camstack-addon",
    "pipeline",
    "orchestrator",
    "load-balancer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/camstack/server.git",
    "directory": "packages/addon-pipeline-orchestrator"
  },
  "homepage": "https://camstack-docs.zentik.app",
  "bugs": {
    "url": "https://github.com/camstack/server/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "camstack": {
    "displayName": "Pipeline Orchestrator",
    "addons": [
      {
        "id": "pipeline-orchestrator",
        "category": "pipeline",
        "name": "Pipeline Orchestrator",
        "version": "0.1.0",
        "description": "Hub-side camera-to-agent load balancer with L1 manual affinity, L2 capacity, and L3 hardware-aware dispatch",
        "entry": "./dist/index.js",
        "execution": {
          "placement": "hub-only",
          "heapProfile": "heavy"
        },
        "capabilities": [
          {
            "name": "pipeline-orchestrator"
          },
          {
            "name": "camera-pipeline-config"
          },
          {
            "name": "zones"
          },
          {
            "name": "zone-rules"
          },
          {
            "name": "addon-widgets-source"
          },
          {
            "name": "viewer-ui"
          },
          {
            "name": "display-palette"
          },
          {
            "name": "node-removal-hook"
          }
        ],
        "passive": true,
        "protected": true,
        "icon": "assets/icon.svg",
        "color": "#6366f1"
      }
    ]
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.widgets.config.ts",
    "build:server": "vite build",
    "build:widgets": "vite build --config vite.widgets.config.ts",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@camstack/types": "*",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@camstack/system": "*",
    "@camstack/types": "*",
    "@camstack/ui-library": "*",
    "@module-federation/vite": "^1.16.9",
    "@vitejs/plugin-react": "^6.0.2",
    "konva": "^10.2.3",
    "lucide-react": "^0.576.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.2.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.11",
    "vitest": "^3.0.0",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0"
  }
}
