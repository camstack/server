{
  "name": "@dominevo/mcp-develop",
  "version": "0.1.0",
  "description": "Library behind `dominevo mcp --toolsets develop`: registers the addon-author tools (catalogue, scaffold, validate, find_example, track review) on an MCP server. The standalone server binary is retired.",
  "keywords": [
    "camstack",
    "mcp",
    "addon",
    "develop"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dominevo/server.git",
    "directory": "packages/mcp-develop"
  },
  "homepage": "https://camstack-docs.zentik.app",
  "bugs": {
    "url": "https://github.com/dominevo/server/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dominevo/develop": "0.1.0",
    "@dominevo/types": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "~6.0.3",
    "vitest": "^3.0.0"
  }
}
