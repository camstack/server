{
  "name": "@camstack/mcp-develop",
  "version": "0.1.27",
  "description": "MCP server for CamStack plugin authors — catalogue, scaffold, validate, find_example, and track review (wraps @camstack/develop).",
  "keywords": [
    "camstack",
    "mcp",
    "addon",
    "develop"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/camstack/server.git",
    "directory": "packages/mcp-develop"
  },
  "homepage": "https://camstack-docs.zentik.app",
  "bugs": {
    "url": "https://github.com/camstack/server/issues"
  },
  "type": "module",
  "bin": {
    "camstack-mcp-develop": "dist/server.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "start": "node dist/server.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@camstack/develop": "*",
    "@camstack/types": "*",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "~6.0.3",
    "vitest": "^3.0.0"
  }
}
