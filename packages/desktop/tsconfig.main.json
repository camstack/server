{
  "compilerOptions": {
    "target": "ES2023",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": false,
    "types": [
      "node"
    ],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@camstack/node-root": [
        "../node-root/src/index.ts"
      ],
      "@camstack/types": [
        "../types/src/index.ts"
      ],
      "@camstack/owner-only-file": [
        "../types/src/util/owner-only-file.ts"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/__tests__/**"
  ]
}
