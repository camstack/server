{
  "name": "@camstack/addon-provider-bosch",
  "version": "0.1.25",
  "description": "Bosch smart-home device-provider addons for CamStack — SHC, Home Connect, and HomeCom cloud integrations (scaffold)",
  "keywords": [
    "camstack",
    "addon",
    "camstack-addon",
    "bosch",
    "shc",
    "home-connect",
    "homecom",
    "provider"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/camstack/server.git",
    "directory": "packages/addon-provider-bosch"
  },
  "homepage": "https://camstack-docs.zentik.app",
  "bugs": {
    "url": "https://github.com/camstack/server/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "camstack": {
    "displayName": "Bosch",
    "addons": [
      {
        "id": "bosch-shc",
        "category": "providers",
        "name": "Bosch SHC",
        "version": "0.1.0",
        "description": "Adopt Bosch Smart Home Controller (SHC) devices via account onboarding — scaffold",
        "entry": "./dist/shc/addon.js",
        "icon": "assets/bosch-shc/icon.png",
        "color": "#E20015",
        "mode": "account",
        "instanceMode": "multiple",
        "execution": {
          "placement": "hub-only"
        },
        "capabilities": [
          {
            "name": "device-provider"
          },
          {
            "name": "device-adoption"
          },
          {
            "name": "connection-test"
          }
        ]
      },
      {
        "id": "bosch-home-connect",
        "category": "providers",
        "name": "Bosch Home Connect",
        "version": "0.1.0",
        "description": "Adopt Bosch Home Connect appliances via account onboarding — scaffold",
        "entry": "./dist/home-connect/addon.js",
        "icon": "assets/bosch-home-connect/icon.png",
        "color": "#E20015",
        "mode": "account",
        "instanceMode": "multiple",
        "execution": {
          "placement": "hub-only"
        },
        "capabilities": [
          {
            "name": "device-provider"
          },
          {
            "name": "device-adoption"
          },
          {
            "name": "connection-test"
          },
          {
            "name": "dishwasher"
          },
          {
            "name": "consumables"
          },
          {
            "name": "running-state"
          }
        ]
      },
      {
        "id": "bosch-homecom",
        "category": "providers",
        "name": "Bosch HomeCom",
        "version": "0.1.0",
        "description": "Adopt Bosch HomeCom climate and water-heating devices via account onboarding — scaffold",
        "entry": "./dist/homecom/addon.js",
        "icon": "assets/bosch-homecom/icon.png",
        "color": "#E20015",
        "mode": "account",
        "instanceMode": "multiple",
        "execution": {
          "placement": "hub-only"
        },
        "capabilities": [
          {
            "name": "device-provider"
          },
          {
            "name": "device-adoption"
          },
          {
            "name": "connection-test"
          },
          {
            "name": "climate-control"
          },
          {
            "name": "water-heater"
          }
        ]
      }
    ]
  },
  "files": [
    "dist",
    "i18n",
    "assets"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "publish:npm": "npm publish --access public"
  },
  "devDependencies": {
    "@camstack/types": "*",
    "typescript": "~6.0.3",
    "vite": "^8.0.11",
    "vitest": "^2.0.0"
  }
}
