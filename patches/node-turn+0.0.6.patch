+  var channelMsg = new ChannelMsg();
+  if (!channelMsg.read(udpMessage)) {
+    return false;
+  }
+
+  var peer = allocation.channelBindings[channelMsg.channelNumber];
+  if (!peer) {
+    return false;
+  }
+
+  var permission = allocation.permissions[peer.address];
+  if (!permission || permission < Date.now()) {
+    return false;
+  }
+
+  // The ChannelData message is relayed out the relay socket to the bound peer,
+  // stripped of its 4-byte ChannelData header (same as send.js's indication).
+  allocation.sockets[0].send(channelMsg.data, peer.port, peer.address, function(err) {
+    if (err) {
+      return server.debug('ERROR', err);
+    }
+    server.debug('TRACE', 'relaying client data over channelNumber ' + channelMsg.channelNumber + ' to ' + peer);
+  });
+  return true;
+}
