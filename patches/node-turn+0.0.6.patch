+  // ChannelData frames begin with a channel number in 0x4000–0x7FFE, i.e. a
+  // first byte in 0x40–0x7F. Anything else is a STUN message — leave it alone.
+  if (udpMessage.length < 4) {
+    return false;
+  }
+  var firstByte = udpMessage[0];
+  if (firstByte < 0x40 || firstByte > 0x7f) {
+    return false;
+  }
