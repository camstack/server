npx tsx scripts/check-container-priority-in-sync.ts || exit 1
npx tsx scripts/check-device-selection-in-sync.ts || exit 1
# The viewer's hand mirrors of NC clearable-key lists and of pruneBannerFor
# (final review m4): the submodule is on disk here, and absent in CI.
npx tsx scripts/check-nc-mirrors-in-sync.ts || exit 1
# D637 family scoping, including the viewer half (skipped in CI: no submodule).
npx tsx scripts/check-nc-system-filter-scope.ts || exit 1
