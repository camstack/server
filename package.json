{
  "name": "camstack",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/camstack/server.git"
  },
  "workspaces": [
    "packages/*",
    "server/*",
    "e2e"
  ],
  "scripts": {
    "build": "npx nx run-many -t build",
    "codegen": "tsx scripts/codegen.ts",
    "icons:catalog": "tsx scripts/generate-icon-catalog.ts",
    "codegen:check": "tsx scripts/codegen.ts --check",
    "models:notices": "tsx scripts/gen-model-licenses.ts",
    "docs:generate": "tsx scripts/docs-generate.ts && tsx scripts/gen-api-reference.ts",
    "docs:drift": "tsx scripts/check-docs-drift.ts",
    "docs:check": "tsx scripts/docs-generate.ts --check && tsx scripts/gen-api-reference.ts --check && tsx scripts/check-docs-drift.ts && tsx scripts/check-subsystem-map.ts && tsx scripts/skills/gen-skill-pointers.ts --check && tsx scripts/ui/gen-ui-catalogue.ts --check",
    "docs:pointers": "tsx scripts/skills/gen-skill-pointers.ts",
    "ui:catalogue": "tsx scripts/ui/gen-ui-catalogue.ts",
    "ui:find": "tsx scripts/ui/cli.ts find",
    "ui:show": "tsx scripts/ui/cli.ts show",
    "ui:tokens": "tsx scripts/ui/cli.ts tokens",
    "ui:check": "tsx scripts/ui/cli.ts check",
    "ui:i18n": "tsx scripts/check-admin-i18n.ts",
    "i18n:set": "tsx scripts/i18n/cli.ts set",
    "i18n:get": "tsx scripts/i18n/cli.ts get",
    "i18n:keys": "tsx scripts/i18n/cli.ts keys",
    "ui:shots": "tsx scripts/ui/shots/cli.ts",
    "docs:subsystems": "tsx scripts/check-subsystem-map.ts",
    "docs:public-stale": "tsx scripts/check-public-docs-staleness.ts",
    "test:scripts": "vitest run scripts/__tests__ --exclude '**/check-public-docs-staleness.spec.ts' --exclude '**/skill-pointers.spec.ts'",
    "test:heavy": "tsx scripts/run-heavy-specs.ts",
    "test:scripts:slow": "CAMSTACK_REAL_TREE_SPECS=1 vitest run scripts/__tests__",
    "validate-addon": "tsx scripts/validate-addon.ts",
    "build:sdk": "npx nx run sdk:build",
    "build:ui": "npx nx run ui-library:build",
    "build:server": "npm run build -w server/backend",
    "build:admin": "npm run build -w packages/addon-admin-ui",
    "dev": "bash scripts/dev.sh",
    "dev:full": "bash scripts/dev.sh --watch",
    "dev:watch": "bash scripts/dev-watch-packages.sh",
    "dev:server": "npm run serve -w server/backend",
    "dev:cluster": "bash scripts/dev-cluster.sh",
    "dev:agent": "bash scripts/dev-agent-only.sh",
    "dev:admin": "npm run dev -w packages/addon-admin-ui",
    "start": "npm start -w server/backend",
    "verify:push": "bash scripts/ci/verify-push.sh",
    "typecheck": "tsx scripts/check-ci-baselines.ts typecheck typecheck-specs",
    "typecheck:tsc6": "tsx scripts/check-ci-baselines.ts --engine=tsc typecheck typecheck-specs",
    "typecheck:raw": "npx nx run-many -t typecheck",
    "typecheck:tsgo": "tsx scripts/typecheck-tsgo.ts",
    "test": "npx nx run-many -t test",
    "test:affected": "npx nx affected -t test",
    "test:e2e": "npm test -w @camstack/e2e",
    "test:cluster": "npm run test:cluster -w packages/system -w server/backend",
    "test:watch": "vitest",
    "test:server": "npm run test -w server/backend",
    "typecheck:server": "npm run typecheck -w server/backend",
    "build:addons": "bash scripts/build-addons.sh",
    "dev:link-addons": "bash scripts/link-dev-addons.sh",
    "deploy-addon": "bash scripts/deploy-addon.sh",
    "redeploy": "bash scripts/redeploy.sh",
    "dev:agent-ui": "bash scripts/dev-agent-ui.sh",
    "desktop:dev": "npm run build -w packages/desktop && npm run dev -w packages/desktop",
    "desktop:pack": "npm run build -w packages/desktop && npm run pack -w packages/desktop",
    "desktop:dist:mac": "npm run build -w packages/desktop && npm run dist:mac -w packages/desktop",
    "desktop:dist:win": "npm run build -w packages/desktop && npm run dist:win -w packages/desktop",
    "desktop:dist:linux": "npm run build -w packages/desktop && npm run dist:linux -w packages/desktop",
    "setup:restreamer": "bash scripts/install-go2rtc.sh",
    "hunt-zombies": "bash scripts/hunt-zombies.sh --wide",
    "hunt-zombies:kill": "bash scripts/hunt-zombies.sh --kill --wide",
    "publish": "bash scripts/publish.sh",
    "publish:dry": "bash scripts/publish.sh --dry-run",
    "publish:all": "bash scripts/publish.sh --all",
    "check-deps": "tsx scripts/check-deps.ts",
    "check-deps:fix": "tsx scripts/check-deps.ts --fix",
    "check:collections": "tsx scripts/check-collection-declarations.ts",
    "check:durable": "tsx scripts/check-durable-state-declared.ts",
    "check:widgets": "tsx scripts/check-host-widget-resolves.ts",
    "lint": "oxlint packages/*/src server/backend/src && biome lint .",
    "lint:fix": "oxlint --fix packages/*/src server/backend/src",
    "lint:guards": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:multi-agent": "tsx scripts/test-multi-agent.ts",
    "test:pipeline-inheritance": "tsx scripts/test-pipeline-inheritance.mts",
    "test:bench-flow": "tsx scripts/test-bench-flow.mts",
    "bench:stream-broker-gc": "tsx scripts/bench-stream-broker-gc.mts",
    "postinstall": "patch-package",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@nx/devkit": "^23.0.0",
    "@types/js-yaml": "^4.0.9",
    "ajv": "^8.18.0",
    "assemblyscript": "^0.28.12",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "lint-staged": "^16.4.0",
    "nx": "^23.0.0",
    "oxc-transform": "^0.153.0",
    "oxlint": "^1.70.0",
    "patch-package": "^8.0.0",
    "playwright": "^1.59.1",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "undici": "^7.28.0",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint",
      "biome format --write",
      "biome lint --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "msgpack5": "^6.0.2",
    "sharp": "^0.35.2",
    "werift": "0.22.9"
  },
  "overrides": {
    "node-gyp": "^10.0.0"
  }
}
